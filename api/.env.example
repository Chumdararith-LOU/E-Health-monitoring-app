# Copy to api/.env and adjust. Every variable is optional except JWT_SECRET in production.

# Port the API listens on
PORT=3000

# development | test | production
NODE_ENV=development

# SQLite file, relative to api/ (api/data/ is git-ignored)
DB_FILE=./data/ehealth.db

# Secret used to sign login tokens. Required in production; a fixed dev value is used otherwise
# JWT_SECRET=

# Allow passwordless dev login. Defaults to true in development; always false in production
DEV_LOGIN=true

# Origin allowed by CORS (the web app's dev server)
CORS_ORIGIN=http://localhost:5173

# Email codes (verify email, reset password).
# false = nothing is sent; the code is printed in the API console instead (use this in dev)
# true  = send with Resend, so RESEND_API_KEY and MAIL_FROM are required
MAIL_ENABLED=false
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=E-Health <no-reply@your-verified-domain.com>

# Optional: seed demo users & 90 days of readings on server boot (idempotent)
# SEED_DEMO=true

# Optional: path to built web/dist folder when serving Web + API from one server
# WEB_DIST_DIR=../web/dist
